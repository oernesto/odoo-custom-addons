<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_petstyle" model="ir.module.category">
        <field name="name">PetStyle</field>
        <field name="description">Helps you manage pets and bath orders.</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_petstyle" model="res.groups.privilege">
        <field name="name">PetStyle</field>
        <field name="category_id" ref="module_category_petstyle"/>
    </record>

    <record id="group_petstyle_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_petstyle"/>
        <field name="comment">Can manage bath orders and register pets.</field>
    </record>

    <record id="group_petstyle_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_petstyle"/>
        <field name="implied_ids" eval="[(4, ref('group_petstyle_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full access, including deleting pets.</field>
    </record>
</odoo>
