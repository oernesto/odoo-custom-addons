<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="petstyle_pet_view_list" model="ir.ui.view">
        <field name="name">petstyle.pet.list</field>
        <field name="model">petstyle.pet</field>
        <field name="arch" type="xml">
            <list>
                <field name="pet_name"/>
                <field name="owner_name"/>
                <field name="size"/>
                <field name="race"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="petstyle_pet_view_form" model="ir.ui.view">
        <field name="name">petstyle.pet.form</field>
        <field name="model">petstyle.pet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="pet_name"/>
                            <field name="size"/>
                            <field name="race"/>
                        </group>
                        <group>
                            <field name="owner_name"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="petstyle_pet_action" model="ir.actions.act_window">
        <field name="name">Pets</field>
        <field name="res_model">petstyle.pet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
