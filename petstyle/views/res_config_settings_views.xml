<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.petstyle</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="PetStyle" string="PetStyle" name="petstyle" groups="petstyle.group_petstyle_manager">
                    <block title="WhatsApp Reminders" id="petstyle_whatsapp_container">
                        <setting help="Notify the owner before a bath order, via the WhatsApp Cloud API (Meta).">
                            <field name="petstyle_whatsapp_enabled"/>
                            <div class="content-group" invisible="not petstyle_whatsapp_enabled">
                                <div class="row mt16">
                                    <label for="petstyle_whatsapp_token" class="col-lg-4"/>
                                    <field name="petstyle_whatsapp_token" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="petstyle_whatsapp_phone_id" class="col-lg-4"/>
                                    <field name="petstyle_whatsapp_phone_id"/>
                                </div>
                                <div class="row">
                                    <label for="petstyle_whatsapp_template" class="col-lg-4"/>
                                    <field name="petstyle_whatsapp_template"/>
                                </div>
                                <div class="row">
                                    <label for="petstyle_whatsapp_language" class="col-lg-4"/>
                                    <field name="petstyle_whatsapp_language"/>
                                </div>
                                <div class="row">
                                    <label for="petstyle_whatsapp_lead_minutes" class="col-lg-4"/>
                                    <field name="petstyle_whatsapp_lead_minutes"/>
                                </div>
                                <div class="row">
                                    <label for="petstyle_whatsapp_country_code" class="col-lg-4"/>
                                    <field name="petstyle_whatsapp_country_code"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
