<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Services -->
    <record id="service_haircut_wash_style" model="barbershop.service">
        <field name="name">Corte, Lavado, Peinado</field>
        <field name="price">500.0</field>
        <field name="duration">30</field>
        <field name="sequence">10</field>
    </record>

    <record id="service_haircut_wash_shave_style" model="barbershop.service">
        <field name="name">Corte, Lavado, Afeitado, Peinado</field>
        <field name="price">650.0</field>
        <field name="duration">45</field>
        <field name="sequence">11</field>
    </record>

    <record id="service_haircut_wash_beard_eyebrows" model="barbershop.service">
        <field name="name">Corte, Lavado, Barba, Cejas</field>
        <field name="price">700.0</field>
        <field name="duration">30</field>
        <field name="sequence">12</field>
    </record>

    <record id="service_haircut_eyebrows" model="barbershop.service">
        <field name="name">Corte y Cejas</field>
        <field name="price">600.0</field>
        <field name="duration">30</field>
        <field name="sequence">13</field>
    </record>

    <record id="service_beard" model="barbershop.service">
        <field name="name">Barba</field>
        <field name="price">300.0</field>
        <field name="duration">30</field>
        <field name="sequence">14</field>
    </record>

    <record id="service_eyebrows" model="barbershop.service">
        <field name="name">Ceja</field>
        <field name="price">200.0</field>
        <field name="duration">30</field>
        <field name="sequence">15</field>
    </record>

    <!-- Product categories -->
    <record id="product_category_hair_care" model="product.category">
        <field name="name">Cuidado del Cabello</field>
    </record>

    <record id="product_category_cafeteria" model="product.category">
        <field name="name">Cafeteria</field>
    </record>

    <!-- Products -->
    <record id="product_wax" model="product.template">
        <field name="name">Cera</field>
        <field name="type">consu</field>
        <field name="list_price">350.0</field>
        <field name="categ_id" ref="product_category_hair_care"/>
    </record>

    <record id="product_powder_wax" model="product.template">
        <field name="name">Cera en Polvo</field>
        <field name="type">consu</field>
        <field name="list_price">350.0</field>
        <field name="categ_id" ref="product_category_hair_care"/>
    </record>

    <record id="product_beard_oil" model="product.template">
        <field name="name">Aceite para Barba</field>
        <field name="type">consu</field>
        <field name="list_price">350.0</field>
        <field name="categ_id" ref="product_category_hair_care"/>
    </record>

    <record id="product_coffee" model="product.template">
        <field name="name">Cafe</field>
        <field name="type">consu</field>
        <field name="list_price">80.0</field>
        <field name="categ_id" ref="product_category_cafeteria"/>
    </record>

    <record id="product_cappuccino" model="product.template">
        <field name="name">Capuchino</field>
        <field name="type">consu</field>
        <field name="list_price">100.0</field>
        <field name="categ_id" ref="product_category_cafeteria"/>
    </record>

</odoo>
