<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_barbershop_shop_tree" model="ir.ui.view">
        <field name="name">barbershop.shop.tree</field>
        <field name="model">barbershop.shop</field>
        <field name="arch" type="xml">
            <list string="Barbershops">
                <field name="name"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="chair_count" string="Chairs"/>
                <field name="order_count" string="Orders"/>
            </list>
        </field>
    </record>

    <record id="view_barbershop_shop_form" model="ir.ui.view">
        <field name="name">barbershop.shop.form</field>
        <field name="model">barbershop.shop</field>
        <field name="arch" type="xml">
            <form string="Barbershop">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_chairs" type="object" class="oe_stat_button" icon="fa-cut">
                            <field name="chair_count" widget="statinfo" string="Chairs"/>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Downtown Barbershop"/></h1>
                    </div>
                    <group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Contact &amp; Company">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chairs" name="chairs">
                            <field name="chair_ids">
                                <list string="Chairs" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="barber_id"/>
                                    <field name="active" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payment Methods" name="payment_methods">
                            <field name="payment_method_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_barbershop_shop" model="ir.actions.act_window">
        <field name="name">Barbershops</field>
        <field name="res_model">barbershop.shop</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first barbershop
            </p>
            <p>
                A barbershop is a physical location with an address, chairs and barbers.
            </p>
        </field>
    </record>
</odoo>
