<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_barbershop_payment_method_tree" model="ir.ui.view">
        <field name="name">barbershop.payment.method.tree</field>
        <field name="model">barbershop.payment.method</field>
        <field name="arch" type="xml">
            <list string="Payment Methods" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="payment_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_barbershop_payment_method_form" model="ir.ui.view">
        <field name="name">barbershop.payment.method.form</field>
        <field name="model">barbershop.payment.method</field>
        <field name="arch" type="xml">
            <form string="Payment Method">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="payment_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_barbershop_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">barbershop.payment.method</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a payment method
            </p>
            <p>
                By default cash, bank transfer and card are available. Assign the ones
                you want to accept to each barbershop.
            </p>
        </field>
    </record>
</odoo>
