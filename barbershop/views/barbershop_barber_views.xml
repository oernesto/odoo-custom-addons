<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_barbershop_barber_tree" model="ir.ui.view">
        <field name="name">barbershop.barber.tree</field>
        <field name="model">barbershop.barber</field>
        <field name="arch" type="xml">
            <list string="Barbers">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="shop_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_barbershop_barber_form" model="ir.ui.view">
        <field name="name">barbershop.barber.form</field>
        <field name="model">barbershop.barber</field>
        <field name="arch" type="xml">
            <form string="Barber">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. John Doe"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="shop_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Chairs" name="chairs">
                            <field name="chair_ids" readonly="1">
                                <list string="Chairs">
                                    <field name="shop_id"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_barbershop_barber" model="ir.actions.act_window">
        <field name="name">Barbers</field>
        <field name="res_model">barbershop.barber</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first barber
            </p>
        </field>
    </record>
</odoo>
