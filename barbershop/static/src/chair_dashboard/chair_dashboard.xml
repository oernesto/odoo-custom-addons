<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="barbershop.ChairDashboard">
        <div class="o_barbershop_chair_dashboard d-flex h-100">
            <div class="o_barbershop_chair_list border-end p-3 flex-shrink-0" style="width: 320px; overflow-y: auto;">
                <t t-foreach="state.shops" t-as="shop" t-key="shop.id">
                    <h6 class="text-muted text-uppercase mt-1 mb-2" t-esc="shop.name"/>
                    <div class="d-flex flex-column gap-2 mb-4">
                        <t t-foreach="shop.chairs" t-as="chair" t-key="chair.id">
                            <div t-attf-class="d-flex align-items-center gap-2 p-1 rounded {{ chair.id === state.selectedChairId ? 'border border-primary' : 'border border-transparent' }}">
                                <div t-attf-class="d-flex flex-column align-items-center justify-content-center text-center rounded shadow-sm {{ !chair.active ? 'text-bg-secondary' : (chair.is_busy ? 'text-bg-warning' : 'text-bg-success') }}"
                                     style="width: 84px; height: 84px; cursor: pointer; flex-shrink: 0;"
                                     t-on-click="() => this.selectChair(chair.id)">
                                    <i class="fa fa-cut fa-lg mb-1"/>
                                    <div class="fw-bold small text-truncate w-100 px-1" t-esc="chair.name"/>
                                    <div class="small text-truncate w-100 px-1" t-if="chair.barber_id" t-esc="chair.barber_id[1]"/>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center flex-shrink-0"
                                        style="width: 32px; height: 32px;"
                                        t-on-click="() => this.editChair(chair.id)"
                                        title="Edit chair">
                                    <i class="fa fa-pencil"/>
                                </button>
                                <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 text-nowrap"
                                        t-on-click="() => this.createOrder(chair.id)">
                                    <i class="fa fa-plus"/> New Order
                                </button>
                            </div>
                        </t>
                    </div>
                </t>
                <div t-if="!state.shops.length" class="text-muted">
                    No chairs found.
                </div>
            </div>
            <div class="o_barbershop_order_panel flex-grow-1 p-3" style="overflow-y: auto;">
                <t t-if="!selectedChair">
                    <div class="text-muted">Select a chair on the left to see its orders for today.</div>
                </t>
                <t t-else="">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            <t t-esc="selectedChair.shopName"/> — <t t-esc="selectedChair.name"/>
                            <span class="text-muted small ms-2" t-if="selectedChair.barber_id" t-esc="selectedChair.barber_id[1]"/>
                        </h5>
                        <button class="btn btn-primary d-flex align-items-center gap-1"
                                t-on-click="() => this.createOrder(selectedChair.id)">
                            <i class="fa fa-plus"/> New Order
                        </button>
                    </div>
                    <t t-if="state.ordersLoading">
                        <div class="text-muted">Loading...</div>
                    </t>
                    <t t-elif="!state.orders || !state.orders.length">
                        <div class="text-muted">No orders for this chair today.</div>
                    </t>
                    <table t-else="" class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Payment</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Tip</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.orders" t-as="order" t-key="order.id"
                                style="cursor: pointer;" t-on-click="() => this.openOrder(order.id)">
                                <td t-esc="order.timeLabel"/>
                                <td t-esc="order.name"/>
                                <td t-esc="order.partner_id ? order.partner_id[1] : ''"/>
                                <td t-esc="order.payment_method_id ? order.payment_method_id[1] : ''"/>
                                <td class="text-end" t-esc="order.amountLabel"/>
                                <td class="text-end" t-esc="order.tipLabel"/>
                                <td>
                                    <span t-attf-class="badge {{ order.state === 'paid' ? 'text-bg-success' : (order.state === 'cancelled' ? 'text-bg-danger' : 'text-bg-secondary') }}"
                                          t-esc="stateLabels[order.state] || order.state"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </div>
    </t>

</templates>
