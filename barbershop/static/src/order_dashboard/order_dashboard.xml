<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="barbershop.OrderDashboard">
        <div class="o_barbershop_order_dashboard p-4" style="overflow-y: auto; height: 100%;">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <h4 class="mb-0">Barbershop Statistics</h4>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="btn-group" role="group">
                        <button type="button"
                                t-attf-class="btn btn-sm {{ state.activePreset === 'today' ? 'btn-primary' : 'btn-outline-primary' }}"
                                t-on-click="() => this.setPreset('today')">Today</button>
                        <button type="button"
                                t-attf-class="btn btn-sm {{ state.activePreset === 'week' ? 'btn-primary' : 'btn-outline-primary' }}"
                                t-on-click="() => this.setPreset('week')">This Week</button>
                        <button type="button"
                                t-attf-class="btn btn-sm {{ state.activePreset === 'month' ? 'btn-primary' : 'btn-outline-primary' }}"
                                t-on-click="() => this.setPreset('month')">This Month</button>
                        <button type="button"
                                t-attf-class="btn btn-sm {{ state.activePreset === 'year' ? 'btn-primary' : 'btn-outline-primary' }}"
                                t-on-click="() => this.setPreset('year')">This Year</button>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="small text-muted mb-0">From</label>
                        <input type="date" class="form-control form-control-sm" style="width: 150px;"
                               t-att-value="state.dateFrom" t-on-change="(ev) => this.onDateFromChange(ev)"/>
                        <label class="small text-muted mb-0">To</label>
                        <input type="date" class="form-control form-control-sm" style="width: 150px;"
                               t-att-value="state.dateTo" t-on-change="(ev) => this.onDateToChange(ev)"/>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="fa fa-users fa-2x text-primary"/>
                            <div>
                                <div class="text-muted small">Customers Served</div>
                                <div class="fs-3 fw-bold" t-esc="state.kpi.customer_count"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="fa fa-list-alt fa-2x text-primary"/>
                            <div>
                                <div class="text-muted small">Orders</div>
                                <div class="fs-3 fw-bold" t-esc="state.kpi.order_count"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="fa fa-money fa-2x text-primary"/>
                            <div>
                                <div class="text-muted small">Total Amount</div>
                                <div class="fs-3 fw-bold" t-esc="amountTotalLabel"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="fa fa-scissors fa-2x text-primary"/>
                            <div>
                                <div class="text-muted small">Total for Barbers</div>
                                <div class="fs-3 fw-bold" t-esc="barberAmountLabel"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="fa fa-building fa-2x text-primary"/>
                            <div>
                                <div class="text-muted small">Total for Barbershop</div>
                                <div class="fs-3 fw-bold" t-esc="shopAmountLabel"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="fa fa-heart fa-2x text-primary"/>
                            <div>
                                <div class="text-muted small">Tips</div>
                                <div class="fs-3 fw-bold" t-esc="tipAmountLabel"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="text-muted">Loading...</div>

            <t t-if="!state.loading &amp;&amp; !state.byChair.length">
                <div class="text-muted">No paid orders in this date range.</div>
            </t>

            <t t-if="!state.loading &amp;&amp; state.byChair.length">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-muted text-uppercase mb-0">Orders &amp; Amount Over Time</h6>
                            <span class="badge text-bg-light text-muted">
                                <t t-esc="granularityLabel"/>
                            </span>
                        </div>
                        <div style="height: 280px;">
                            <canvas t-ref="timeChartCanvas"/>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-3">Amount by Chair</h6>
                        <div style="height: 280px;">
                            <canvas t-ref="chartCanvas"/>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-3">Orders by Chair</h6>
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Chair</th>
                                    <th>Barbershop</th>
                                    <th class="text-end">Orders</th>
                                    <th class="text-end">Customers</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-end">Barber</th>
                                    <th class="text-end">Barbershop</th>
                                    <th class="text-end">Tips</th>
                                    <th class="text-end">Avg. Ticket</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.byChair" t-as="row" t-key="row.chair_id || 'none'">
                                    <td t-esc="row.chair_name"/>
                                    <td t-esc="row.shop_name"/>
                                    <td class="text-end" t-esc="row.order_count"/>
                                    <td class="text-end" t-esc="row.customer_count"/>
                                    <td class="text-end" t-esc="row.amountLabel"/>
                                    <td class="text-end" t-esc="row.barberLabel"/>
                                    <td class="text-end" t-esc="row.shopLabel"/>
                                    <td class="text-end" t-esc="row.tipLabel"/>
                                    <td class="text-end" t-esc="row.avgLabel"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
